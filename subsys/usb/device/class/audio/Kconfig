# USB AUDIO configuration options

# Copyright (c) 2020 Nordic Semiconductor ASA
# SPDX-License-Identifier: Apache-2.0

config USB_DEVICE_AUDIO
	bool "USB Audio Device Class Driver"
	help
	  USB Audio Device Class driver.
	  Zephyr USB Audio Class is considered experimental
	  and not full.
	  Device configuration is done via dt overlay.

if USB_DEVICE_AUDIO

module = USB_AUDIO
module-str = USB Audio
source "subsys/logging/Kconfig.template.log_config"


config USB_DEVICE_AUDIO_MIN_VOLUME
	hex "USB Audio Device Min Volume"
	default 0
	range 0 0x8000
	help 
	  attributes can range from +127.9961 dB (0x7FFF) down to -127.9961 dB (0x8001)

config USB_DEVICE_AUDIO_MAX_VOLUME
	hex "USB Audio Device Max Volume"
	default 0x7FFF
	range 0 0x8000
	help 
	  attributes can range from +127.9961 dB (0x7FFF) down to -127.9961 dB (0x8001)

config USB_DEVICE_AUDIO_RES_VOLUME
	hex "USB Audio Device Max Volume"
	default 0x1
	range 0x1 0x7FFF
	help
	  The settings for the RES attribute can only take positive values and range from 1/256
	  dB (0x0001) to +127.9961 dB (0x7FFF).

endif #USB_DEVICE_AUDIO
